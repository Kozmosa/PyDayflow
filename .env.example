# PyDayflow Configuration

# Debug mode
DEBUG=False

# Web server port
WEB_PORT=5000

# Data directory (defaults to ~/PyDayflow if not set)
# DATA_DIR=/path/to/data

# Recording settings
CAPTURE_FPS=1.0
ANALYSIS_INTERVAL=900
RETENTION_DAYS=3

# AI Provider: 'gemini' or 'local'
AI_PROVIDER=gemini

# Gemini API settings (if using Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local LLM settings (if using local models like Ollama)
LOCAL_LLM_URL=http://localhost:11434
